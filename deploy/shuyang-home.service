[Unit]
Description=Shuyang Home Membership
After=network.target

[Service]
Type=simple
User=shuyang
Group=shuyang
WorkingDirectory=/opt/shuyang-home
EnvironmentFile=/etc/shuyang-home.env
ExecStart=/usr/bin/java -Xms128m -Xmx768m -jar /opt/shuyang-home/shuyang-home.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shuyang-home
UMask=0077

[Install]
WantedBy=multi-user.target
