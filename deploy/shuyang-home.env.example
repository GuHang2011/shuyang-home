SHUYANG_PORT=9999
SHUYANG_DB_URL=jdbc:h2:file:/var/lib/shuyang-home/shuyang-home;DB_CLOSE_ON_EXIT=FALSE
SHUYANG_DB_USER=sa
SHUYANG_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
SHUYANG_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_INITIAL_ADMIN_PASSWORD
SHUYANG_DATA_KEY=REPLACE_WITH_BASE64_AES_KEY
SHUYANG_ALLOWED_ORIGINS=https://members.example.com
# Production must use the visitor address supplied by the trusted proxy, never the server exit.
SHUYANG_WEATHER_LOCAL_NETWORK=false

# Optional AI assistant. Keep credentials on the server only; restart after changing.
# Use the provider's API prefix, e.g. https://provider.example/v1 (without /chat/completions).
SHUYANG_AI_ENABLED=false
SHUYANG_AI_BASE_URL=
SHUYANG_AI_API_KEY=
SHUYANG_AI_MODEL=
