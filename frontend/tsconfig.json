{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"moduleResolution": "Node",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": { "@/*": ["src/*"], "/@/*": ["src/*"] },
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"]
}
