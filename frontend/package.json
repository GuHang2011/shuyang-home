{
  "name": "shuyang-home-web",
  "version": "1.5.0",
  "private": true,
  "description": "沭阳之家会员系统 · 乡情相聚，守望相助",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test:regression": "node ../scripts/test-request-scopes.cjs && node ../scripts/test-weather.cjs && node ../scripts/test-audit-regressions.cjs && npm run test:mobile && node ../scripts/test-photo-uploads.cjs && npm run test:modules && npm run test:stickers && npm run test:files",
    "test:files": "node ../scripts/test-business-files.cjs",
    "test:stickers": "node ../scripts/test-chat-stickers.cjs",
    "test:modules": "node ../scripts/test-module-regressions.cjs",
    "test:mobile": "node ../scripts/test-mobile-environments.cjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@zxing/browser": "0.1.5",
    "element-plus": "2.14.7",
    "qrcode": "1.5.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "18.11.13",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "4.0.0",
    "typescript": "4.9.4",
    "vite": "4.0.0",
    "vue-tsc": "^1.8.27"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
